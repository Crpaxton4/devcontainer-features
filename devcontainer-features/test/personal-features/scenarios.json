{
    "with_node_and_gh": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "ghcr.io/devcontainers/features/node:1": {
                "version": "lts"
            },
            "ghcr.io/devcontainers/features/github-cli:1": {},
            "personal-features": {}
        },
        "remoteUser": "vscode"
    },
    "on_odoo_base_image": {
        "image": "odoo:19",
        "features": {
            "ghcr.io/devcontainers/features/node:1": {
                "version": "lts"
            },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    "on_odoo18_base_image": {
        "image": "odoo:18",
        "features": {
            "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    "on_odoo17_base_image": {
        "image": "odoo:17",
        "features": {
            "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    // Built, not pulled: Debian 11 is EOL, so odoo:16's apt sources have to be
    // repointed at archive.debian.org *before* any feature installs, and feature
    // installs happen during the image build (#688). The Dockerfile lives in the
    // sibling 'on_odoo16_base_image/' directory, which `devcontainer features
    // test` copies into the generated .devcontainer/ - hence the bare
    // "Dockerfile" path here. See that file for the full rationale.
    "on_odoo16_base_image": {
        "build": { "dockerfile": "Dockerfile" },
        "features": {
            "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    // The four images every QOC project devcontainer actually runs on
    // (QOC-Innovations/.devcontainer, images/odoo/Dockerfile.base, built FROM
    // odoo:16..19), with the Features every project layers on top of them:
    // personal-features via dev.containers.defaultFeatures and second-brain
    // beside it. Pulled as published, never built or patched - the point is
    // the artefact as consumers get it. Compare on_odoo16_base_image above:
    // its Dockerfile repairs the EOL bullseye apt sources that THIS image
    // needs just as much and did not have, which is how test.yaml stayed green
    // while every Odoo 16 devcontainer rebuild failed in docker-outside-of-docker
    // with "404 Not Found" (2026-10-02). The registry is private: `docker login
    // ghcr.io` before running these locally. They are driven by
    // .github/workflows/test-prebuilt-images.yaml (daily, plus push/PR), not by
    // test.yaml's test-scenarios matrix. Tags follow the branch the image repo
    // publishes from ("prebuilt-container-N" today, "N" once that merges to main).
    "on_qoc_prebuilt_16": {
        "image": "ghcr.io/qoc-innovations/qoc-devcontainer:prebuilt-container-16",
        "features": {
            "personal-features": {},
            "second-brain": {}
        },
        "remoteUser": "root"
    },
    "on_qoc_prebuilt_17": {
        "image": "ghcr.io/qoc-innovations/qoc-devcontainer:prebuilt-container-17",
        "features": {
            "personal-features": {},
            "second-brain": {}
        },
        "remoteUser": "root"
    },
    "on_qoc_prebuilt_18": {
        "image": "ghcr.io/qoc-innovations/qoc-devcontainer:prebuilt-container-18",
        "features": {
            "personal-features": {},
            "second-brain": {}
        },
        "remoteUser": "root"
    },
    "on_qoc_prebuilt_19": {
        "image": "ghcr.io/qoc-innovations/qoc-devcontainer:prebuilt-container-19",
        "features": {
            "personal-features": {},
            "second-brain": {}
        },
        "remoteUser": "root"
    }
}
