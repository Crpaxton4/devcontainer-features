{
    "with_node_and_gh": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "ghcr.io/devcontainers/features/node:1": {
                "version": "lts"
            },
            "ghcr.io/devcontainers/features/github-cli:1": {},
            "personal-features": {}
        },
        "remoteUser": "vscode"
    },
    "on_odoo_base_image": {
        "image": "odoo:19",
        "features": {
            "ghcr.io/devcontainers/features/node:1": {
                "version": "lts"
            },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    "on_odoo18_base_image": {
        "image": "odoo:18",
        "features": {
            "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    "on_odoo17_base_image": {
        "image": "odoo:17",
        "features": {
            "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
            "ghcr.io/itsmechlark/features/postgresql:1": {},
            "personal-features": {}
        },
        "remoteUser": "root"
    },
    // Built, not pulled, but NOT to repair apt: the image hands the Features
    // odoo:16's real, dead, EOL mirrors, and personal-features' dependsOn on
    // debian-eol-archives has to repair them (#688, 2026-10-02). The Dockerfile
    // exists to supply postgres: apt.postgresql.org dropped bullseye-pgdg, and
    // the postgresql Feature the other odoo scenarios use leaves a dead
    // pgdg.list behind that breaks every later apt-get update, so on this base
    // postgres is PGDG's postgresql-17 from apt-archive.postgresql.org, with a
    // pq-init.sh that keeps the Feature's contract. The Dockerfile lives in the
    // sibling 'on_odoo16_base_image/' directory, which `devcontainer features
    // test` copies into the generated .devcontainer/ - hence the bare
    // "Dockerfile" path here. See that file for the full rationale.
    "on_odoo16_base_image": {
        "build": { "dockerfile": "Dockerfile" },
        "features": {
            "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
            "personal-features": {}
        },
        "remoteUser": "root"
    }
}
