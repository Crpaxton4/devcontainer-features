#!/usr/bin/env bash
# publish-claude-wrapper — put the `claude` wrapper where every container on this
# machine can run it (#807).
#
# The wrapper install.sh generates is baked into the image, so it changes only on
# rebuild, and two containers on one machine can run two different wrappers.
# This script copies the image's wrapper into $CLAUDE_CONFIG_DIR at
# container-create time, and the wrapper on PATH consults that published copy
# first and execs it when one is there (see the wrapper heredoc in install.sh).
# $CLAUDE_CONFIG_DIR is the one place both ends of the mount agree on —
# /usr/local/share/claude-home in here, ~/.claude out there — so a wrapper
# published by ANY container becomes the wrapper every other container runs,
# without a rebuild. The real Claude binary does not travel with it (its path
# carries the publishing image's Node version), so the on-PATH stub hands its
# own over in CLAUDE_REAL_BIN.
#
# Publication has to happen at container-create time, not at image-build time:
# $CLAUDE_CONFIG_DIR is bind-mounted over at runtime, so anything install.sh
# writes under it is shadowed by the mount and silently discarded. That is the
# same reason sync-claude-hooks runs from the feature-contributed
# postCreateCommand, and this script runs from the same place.
#
# Staleness is reported through the #806 provision marker
# ($CLAUDE_CONFIG_DIR/personal-features-provision.json, written by
# sync-claude-mcp), which fingerprints the wrapper, so an image older than one
# this config dir has already seen announces itself through that one breadcrumb.
#
# Best-effort throughout, like the rest of the runtime provisioning: every
# failure warns and the script still exits 0, because refusing container create
# over a wrapper refresh would be worse than the staleness it guards against.
set -euo pipefail

note() { echo "publish-claude-wrapper: $1" >&2; }

# The wrapper IMPLEMENTATION to publish: the copy install.sh wrote into the
# image, outside the bind mount. Byte-identical to the one it installed on PATH.
# Overridable on the same terms as sync-claude-hooks' PERSONAL_FEATURES_HOOK_CMD,
# so the feature test can publish a fixture instead of the real wrapper.
WRAPPER_SRC="${PERSONAL_FEATURES_CLAUDE_WRAPPER_SRC:-/usr/local/share/personal-features/claude-wrapper}"

# CLAUDE_CONFIG_DIR is the user-scope Claude config root and the container end of
# the ~/.claude bind mount. Without it there is no shared directory to publish
# into, so there is nothing to do.
if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
    note "CLAUDE_CONFIG_DIR is unset; nothing to publish (skipping)."
    exit 0
fi

WRAPPER_DIR="$CLAUDE_CONFIG_DIR/personal-features"
PUBLISHED="$WRAPPER_DIR/claude-wrapper"

# Namespaced under the config dir rather than dropped at its top level: this is
# the feature's own directory inside the user's real ~/.claude, so nothing here
# can collide with a file Claude Code or the user owns.
mkdir -p "$WRAPPER_DIR"

# Same atomic-rename discipline as sync-claude-hooks' publish_shim: stage inside
# the destination directory (hence the same filesystem, which the bind mount and
# /tmp are not), chmod, then rename. A `claude` session already executing keeps
# the old inode, so a republish mid-session can never exec a half-copied file.
publish_wrapper() {
    local src="$1" dst="$2" tmp
    if [ ! -r "$src" ]; then
        note "no wrapper to publish at $src; leaving $dst as it is."
        return 1
    fi
    tmp="$(mktemp -p "$WRAPPER_DIR")" || {
        note "could not stage a temp file in $WRAPPER_DIR; $dst not refreshed."
        return 1
    }
    if cp "$src" "$tmp" 2>/dev/null; then
        # World-readable and world-executable for the same reason the #806
        # marker is world-writable: install.sh cannot know which uid runs
        # postCreateCommand, let alone which uid runs `claude` afterwards, and
        # the wrapper holds no secret.
        chmod 0755 "$tmp"
        mv "$tmp" "$dst"
        return 0
    fi
    rm -f "$tmp"
    note "could not copy $src to $dst."
    return 1
}

if publish_wrapper "$WRAPPER_SRC" "$PUBLISHED"; then
    echo "publish-claude-wrapper: published the claude wrapper to $PUBLISHED"
fi

# Still 0: a failed publish is a warning about this run, and a nonzero exit here
# would break the postCreateCommand chain for every step after it.
exit 0
