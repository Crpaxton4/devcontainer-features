#!/usr/bin/env bash
# sync-claude-hooks — idempotently merge the feature-owned Claude Code lifecycle
# hooks into $CLAUDE_CONFIG_DIR/settings.json.
#
# WHY THIS EXISTS: personal-features bind-mounts the host's ~/.claude over
# $CLAUDE_CONFIG_DIR at runtime, so anything install.sh writes under that
# directory at BUILD time is shadowed by the mount. Like sync-claude-skills,
# this runs via the feature-contributed postCreateCommand — AFTER the mount is
# active — so its edits land in the user's REAL host ~/.claude/settings.json and
# persist across rebuilds and across projects.
#
# The hooks call `claude-event-hook <EventName>`, which forwards each event to
# `odoo-sdk log-event` (see that script). PreToolUse fires on every tool call;
# the shim excludes `mcp__odoo-mcp__*` tools (the odoo MCP server logs those
# server-side, #326/#340), so we register PreToolUse with a match-all matcher
# and let the shim enforce the exclusion.
#
# A SECOND, UNRELATED HOOK rides the same merge (#809): `worktree-context-hook`,
# a SessionStart hook that prints the worktree Bash syntax constraint into the
# session context when the cwd is inside a `.claude/worktrees` checkout. It is a
# separate program because the event shim must never write to stdout and this one
# exists only to write to stdout.
#
# AND THE SHARED SECURITY POLICY RIDES IT TOO (#811). Three more hooks —
# odoo-api-guard.sh, force-push-guard.sh, mempalace-recall.sh — plus a settings
# FRAGMENT (permissions.deny, env, autoMode.environment,
# skillListingBudgetFraction). Those were hand-maintained on one machine and named
# from settings.json by absolute path, so a fresh ~/.claude got every mechanism and
# none of the policy. The hooks get the same publish-then-reference treatment as
# the two shims; the fragment gets a second jq arm in the merge below whose
# semantics are additive-only — see the long note beside it — so it can add policy
# and can never overwrite or remove the user's.
#
# THE SETTINGS FILE IS SHARED WITH THE HOST (#803). Because that mount is
# two-way, the host's own Claude Code sessions read the very same settings.json
# this script writes. A container-absolute command therefore resolves in exactly
# ONE of the two places that run it: on the host every feature hook exit-127s
# (`/bin/sh: 1: /usr/local/bin/claude-event-hook: not found`) and every event it
# was meant to record is silently dropped. So we do not write a container path.
# Instead the shim is PUBLISHED into the shared config dir and referenced through
# a per-machine expansion — see HOOK_SHIM/SHIM_CMD below.
#
# CARE WITH THE USER'S CONFIG: settings.json is the user's real file and may
# hold their own settings AND their own hooks. This merge therefore:
#   * creates the file (as {}) if absent;
#   * replaces ONLY feature-owned hook entries — identified by the HOOK_MARKERS
#     command markers — on re-run, so it is idempotent and never accumulates
#     duplicates;
#   * preserves every user-owned setting and every user-authored hook untouched;
#   * writes only after producing valid JSON (atomic temp-file swap);
#   * leaves a corrupt/unparseable settings.json ALONE and warns, never
#     destroying user config.
#
# IT ALSO RESOLVES EVERY HOOK COMMAND (#805). A hook entry naming a command that
# cannot be executed is not an inert entry: Claude Code exit-127s it, and for a
# PreToolUse guard an exit-127 reads to the harness as an ALLOW, so a prohibition
# enforced by a broken guard is not enforced at all. `odoo-api-guard.sh` failed
# that way 73 times across five sessions with nothing reporting it. See
# check_hook_deps / audit_hook_commands below for the two halves of the check and
# for why they run where they do.
set -euo pipefail

usage() { echo "usage: sync-claude-hooks [--check-deps]" >&2; }

# The event shim IMPLEMENTATION to publish: the copy install.sh placed in the
# image, outside the bind mount. Overridable so tests can publish a fixture
# binary instead. NOTE the changed meaning since #803 — this names the file we
# COPY, not the command we write into settings.json; that is always SHIM_CMD.
HOOK_CMD="${PERSONAL_FEATURES_HOOK_CMD:-/usr/local/bin/claude-event-hook}"

# The worktree-context hook IMPLEMENTATION to publish (#809): a second, separate
# SessionStart hook that states the worktree Bash syntax constraint up front. It
# is a different program from the event shim on purpose — the event shim's
# contract forbids it to write to stdout at all, and this one exists precisely to
# write to stdout. Same override discipline so tests can publish a fixture.
WORKTREE_HOOK_CMD="${PERSONAL_FEATURES_WORKTREE_HOOK_CMD:-/usr/local/bin/worktree-context-hook}"

# The three SHARED SECURITY HOOKS (#811). Until now these lived only in the
# hand-maintained claude-home: settings.json named them by absolute path and no
# component owned the files, so a fresh ~/.claude got every mechanism and none of
# the policy. install.sh stages them under /usr/local/share/personal-features/hooks
# and they are published and registered here exactly like the two shims above.
#   odoo-api-guard.sh    - PreToolUse/Bash; the Odoo external-API prohibition and
#                          the credential denies, with the decode rule narrowed to
#                          decode-piped-into-an-interpreter (#813, #907).
#   force-push-guard.sh  - PreToolUse/Bash; protected-branch force-push denial.
#   mempalace-recall.sh  - SessionStart; palace recall as additionalContext. #744
#                          asserted its existence and refused to STUB it; shipping
#                          the real script masks nothing, so it is owned now.
SHARED_HOOKS_DIR="${PERSONAL_FEATURES_SHARED_HOOKS_DIR:-/usr/local/share/personal-features/hooks}"

# The settings FRAGMENT (#811, #812): permissions.deny, env, autoMode.environment
# and skillListingBudgetFraction, merged into settings.json by the same jq pass
# that merges the hooks block. Data rather than a script, same ownership argument.
SETTINGS_FRAGMENT="${PERSONAL_FEATURES_SETTINGS_FRAGMENT:-/usr/local/share/personal-features/settings-fragment.json}"

# Substrings that identify a feature-owned hook command, used to strip our own
# entries before re-appending them (this is what makes the merge idempotent).
# Kept separate from the commands themselves so an override of the source path in
# tests can't weaken the markers, and kept as a LIST so a later hook whose
# command does not contain `claude-event-hook` can be matched too.
#
# CONTRACT FOR ANYONE ADDING A HOOK ENTRY BELOW: every command you add must be
# matched by at least one marker here. An entry no marker matches is never
# stripped on re-run, so it accumulates one duplicate copy on every container
# create. Add a new hook whose command is a different program -> add its
# identifying substring to this array in the same change.
#
# The three security-hook basenames (#811) are here for the same reason, and with
# one extra effect: `odoo-api-guard.sh` is a substring of the OLD
# /usr/local/share/claude-home/hooks/odoo-api-guard.sh command too, so the
# absolute-path entries an earlier hand-edit left in settings.json are stripped
# and replaced by the published, per-machine-expanded ones rather than left to sit
# beside them (the same #803 migration the event shim gets).
HOOK_MARKERS='["claude-event-hook","worktree-context-hook","odoo-api-guard.sh","force-push-guard.sh","mempalace-recall.sh"]'

# The programs a feature-owned hook command goes on to EXEC. Resolving the hook
# command itself is only half of what a working hook needs: claude-event-hook
# shells out to `odoo-sdk log-event` and guards that call on `command -v`, so an
# unlinked console script turns every feature hook into a dead no-op whose first
# symptom is an empty event table weeks later (#496). odoo-mcp and odoo-tui ship
# in the same wheel, so listing all three also catches a half-installed wheel at
# the one moment it is cheap to fix.
#
# SAME CONTRACT AS HOOK_MARKERS: add a hook whose command shells out to a program
# -> add that program here in the same change. Overridable so the feature test can
# drive --check-deps against names it controls rather than the real toolchain.
HOOK_DEPS=()
IFS=' ' read -r -a HOOK_DEPS <<< "${PERSONAL_FEATURES_HOOK_DEPS:-odoo-sdk odoo-mcp odoo-tui}" || true

# The provision marker (#806) — the one piece of state about this machine's
# feature scripts that outlives the image, because it lives in the shared,
# host-persisted config dir. #804 adds the runtime heartbeat to the SAME file
# rather than a second breadcrumb of its own; see check_hook_heartbeat below.
PROVISION_MARKER_NAME='personal-features-provision.json'

# How long a silence is allowed before it is reported. A week is chosen against
# the failure it is sized for: the #804 outage ran three months, while an
# ordinary gap between container creates is days at most, and a machine genuinely
# idle for a week reports once and then goes quiet again as soon as any session
# records an event. Overridable so the feature test can drive the comparison
# without waiting a week.
HOOK_STALE_SECONDS="${PERSONAL_FEATURES_HOOK_STALE_SECONDS:-604800}"

note() { echo "sync-claude-hooks: $1" >&2; }

# --- hook command resolvability (#805) ---------------------------------------
# This replaces two hand-written one-offs, each added reactively after the thing
# it guarded had already broken: install.sh's odoo-sdk entry-point loop (#496)
# and mempalace-repair's mempalace-recall.sh check (#744). They covered two of
# the commands reachable from settings.json; every other one was provisioned on
# trust. Both are deleted in favour of the two routines below, which check the
# whole set rather than the two that happened to bite.
#
# WHY THE CHECK IS SPLIT IN TWO, AND WHERE EACH HALF RUNS. settings.json lives in
# the bind-mounted config dir, which does not exist at image-build time - that is
# the entire reason this script runs from postCreateCommand instead of install.sh
# (see the header). So "resolve every command in settings.json" is necessarily a
# PROVISION-time check: audit_hook_commands, run below on the file we just wrote.
# HOOK_DEPS is the mirror image: those programs live in the image and nowhere
# else, so resolving them is a BUILD-time check (`--check-deps`, called from
# install.sh) where a broken wheel fails the build instead of shipping. One
# routine per subject, each run at the only time its subject exists.
#
# NECESSARY, NOT SUFFICIENT (#804). This resolves a command at provision time. It
# cannot say the command will still resolve, or still work, at hook time -
# odoo-api-guard.sh resolves fine here and exit-127'd 73 times later. The runtime
# half of that problem is #804 and is deliberately not attempted here.

# Expand a hook command to the program it will exec, WITHOUT running any part of
# it. Claude Code runs hook commands through `/bin/sh -c`, so the honest way to
# find the program is to let a shell expand and word-split the string - but the
# string is user config, and an `eval` over user config must never be able to RUN
# anything. Any command carrying a control operator, a redirection or a
# substitution is therefore refused (return 2 -> reported as unverifiable) rather
# than expanded; with those screened out and globbing disabled,
# `eval "set -- $cmd"` can do parameter expansion, tilde expansion and word
# splitting, and nothing else.
hook_program() {
    # shellcheck disable=SC2016  # these are literal characters to screen FOR, not expansions
    case $1 in
    *'$('* | *'`'* | *';'* | *'&'* | *'|'* | *'<'* | *'>'* | *'
'*)
        return 2
        ;;
    esac
    (
        set -f
        eval "set -- $1" 2>/dev/null || exit 2
        [ "$#" -gt 0 ] || exit 2
        printf '%s\n' "$1"
    )
}

# A program word resolves if it names an existing executable (path form) or if a
# shell can find it (bare name). `command -v` is the bare-name half because it
# covers PATH lookups and shell builtins alike - both things /bin/sh can run.
hook_program_ok() {
    case $1 in
    */*) [ -x "$1" ] ;;
    *) command -v -- "$1" >/dev/null 2>&1 ;;
    esac
}

# BUILD-time half: every program a feature-owned hook command execs must be
# runnable. Non-zero on the first failure, so install.sh can fail the build.
check_hook_deps() {
    local dep rc=0
    for dep in "${HOOK_DEPS[@]}"; do
        if hook_program_ok "$dep"; then
            continue
        fi
        note "ERROR: '$dep' is not runnable, but a feature-owned Claude Code hook command depends on it. claude-event-hook guards on 'command -v' and no-ops SILENTLY when it is missing, so every feature hook would be a dead no-op and the first symptom would be an empty event table weeks later (#496, #805)."
        rc=1
    done
    return "$rc"
}

# Every command in the hooks block of $1, one per line, as
# <event> TAB <feature|user> TAB <command>. Ownership is the HOOK_MARKERS test -
# the same one the merge strips by - so a user's own hooks are reported as
# theirs. Every traversal is type-guarded: a malformed hooks block is the user's
# file to fix and must not crash the sync.
hook_commands_tsv() {
    jq -r --argjson markers "$HOOK_MARKERS" '
      (.hooks | if type == "object" then . else {} end)
      | to_entries[]
      | .key as $ev
      | (.value | if type == "array" then . else [] end)[]
      | (if type == "object" then .hooks else null end
         | if type == "array" then . else [] end)[]
      | (if type == "object" then . else {} end)
      | select((.type // "command") == "command")
      | (.command // "") | select(type == "string" and length > 0) | . as $c
      | [ $ev,
          (if any($markers[]; . as $m | $c | contains($m)) then "feature" else "user" end),
          $c ]
      | @tsv
    ' "$1" 2>/dev/null
}

# PROVISION-time half: resolve every command the settings file now references,
# ours and the user's alike. Ours failing is our bug and is fatal (it can only
# mean the shim guard above was defeated). The user's failing is reported and
# never repaired: this feature does not own those files, and writing a stub would
# look like a working hook while doing nothing - the #744 decision, kept.
audit_hook_commands() {
    local file="$1" ev owner cmd prog fatal=0
    while IFS=$'\t' read -r ev owner cmd; do
        [ -n "${cmd:-}" ] || continue
        if ! prog="$(hook_program "$cmd")"; then
            note "NOTE: the $ev hook command [$cmd] carries a shell operator or a substitution, so the program it runs cannot be identified without executing it; left unchecked (#805)."
            continue
        fi
        if hook_program_ok "$prog"; then
            continue
        fi
        if [ "$owner" = "feature" ]; then
            note "ERROR: the feature-owned $ev hook command [$cmd] resolves to '$prog', which is not executable here; Claude Code would exit-127 it on every $ev (#805)."
            fatal=1
        else
            note "WARNING: the $ev hook command [$cmd] resolves to '$prog', which is missing or not executable. Claude Code will exit-127 it on every $ev, so the hook does nothing at all - and a guard hook that cannot execute reads to the harness as an ALLOW, so whatever it was installed to enforce is not enforced (#805). Not created here: this feature does not own that file, and a stub would look like a working hook while doing nothing (#744)."
        fi
    done < <(hook_commands_tsv "$file")
    return "$fatal"
}

# --- the runtime half of the same question (#804) ------------------------------
# audit_hook_commands above answers "does this command resolve, here, now". #804
# is the observation that the answer can stop being yes at any time afterwards
# and nothing notices: a hook that cannot execute produces no event AND NO
# SIGNAL, so 3,506 events went missing over three months and the only trace was a
# string in the transcripts. The tracker's own tables cannot show it — the
# signature is the ABSENCE of rows, which looks exactly like a quiet week.
#
# Neither half of the pair can be written by the failing component: whatever
# breaks the hook (an unlinked console script, #496; a command that resolves on
# only one side of the mount, #803) stops the shim before any failure counter it
# holds could run. So the breadcrumb is written by the path that SUCCEEDS —
# claude-event-hook stamps last_event_epoch/last_event_at after `odoo-sdk`
# actually exits 0 — and the comparison is made here, by a different program at a
# different time, which is the only arrangement where a total failure of the hook
# still produces a report.
#
# Reported, never fatal, and never a reason to fail closed: #804 explicitly does
# not ask the hook to block, only that its silence stop being indistinguishable
# from its success.

# Write hook_watch_since into the marker, preserving every other key. This is the
# zero point for a config dir that has never recorded an event: without it, "no
# heartbeat" on a brand-new machine is indistinguishable from "no heartbeat for
# three months", and the check would either cry wolf on the first create or stay
# silent forever. Same atomic-rename and 0666 discipline as the marker's other
# writers, and best-effort throughout.
mark_hook_watch() {
    local marker="$1" now="$2" base tmp
    base=''
    if [ -r "$marker" ]; then
        base="$(jq -c 'if type == "object" then . else empty end' "$marker" 2>/dev/null || true)"
    fi
    [ -n "$base" ] || base='{}'
    tmp="$(mktemp "$(dirname "$marker")/.pf-heartbeat.XXXXXX" 2>/dev/null)" || return 0
    if printf '%s' "$base" | jq --argjson now "$now" '. + {hook_watch_since: $now}' \
        > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
        chmod 0666 "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$marker" 2>/dev/null || rm -f "$tmp"
    else
        rm -f "$tmp"
    fi
    return 0
}

# Read one numeric field out of the marker, defaulting to 0 for absent, malformed
# or non-numeric. A marker we cannot parse means "no evidence", never a failure.
marker_number() {
    local value
    value="$(jq -r --arg key "$2" '
        if type == "object" and (.[$key] | type) == "number" then (.[$key] | floor) else 0 end
    ' "$1" 2>/dev/null || true)"
    case "${value:-}" in
    '' | *[!0-9]*) value=0 ;;
    esac
    printf '%s\n' "$value"
}

check_hook_heartbeat() {
    local marker="$1" now last since age at
    now="$(date -u +%s)"
    last=0
    since=0
    at='unknown'
    if [ -r "$marker" ]; then
        last="$(marker_number "$marker" last_event_epoch)"
        since="$(marker_number "$marker" hook_watch_since)"
        at="$(jq -r 'if type == "object" and (.last_event_at | type) == "string"
                     then .last_event_at else "unknown" end' "$marker" 2>/dev/null || true)"
        [ -n "${at:-}" ] || at='unknown'
    fi

    if [ "$last" -gt 0 ]; then
        age=$(( now - last ))
        if [ "$age" -gt "$HOOK_STALE_SECONDS" ]; then
            note "WARNING: the feature-owned Claude Code hooks have not recorded a successful event since $at ($(( age / 86400 ))d ago). The shim stamps that timestamp only after 'odoo-sdk log-event' exits 0, so a silence this long means every event since then was dropped - and a dropped event leaves NO other trace, which is how 3,506 of them went unnoticed for three months (#804). Check that the hook command in $SETTINGS resolves on the machine running the session (#803) and that 'odoo-sdk' is runnable there (#496); evidence in $marker."
        fi
        return 0
    fi

    if [ "$since" -le 0 ]; then
        # First create that ever looked. Record the zero point and say nothing.
        mark_hook_watch "$marker" "$now"
        return 0
    fi

    age=$(( now - since ))
    if [ "$age" -gt "$HOOK_STALE_SECONDS" ]; then
        note "WARNING: no feature-owned Claude Code hook has EVER recorded a successful event in the $(( age / 86400 ))d this config dir has been watched. The hooks are wired into $SETTINGS but nothing is reaching the tracker, so every event in that window was dropped silently (#804). Check that the hook command resolves on the machine running the session (#803) and that 'odoo-sdk' is runnable there (#496); evidence in $marker."
    fi
    return 0
}

# --- mode dispatch -----------------------------------------------------------
# --check-deps is the build-time half described above: it resolves HOOK_DEPS and
# nothing else, touches no config and needs no mount, so it runs before the
# CLAUDE_CONFIG_DIR gate below and is safe to call from install.sh.
if [ "${1:-}" = "--check-deps" ]; then
    if check_hook_deps; then
        exit 0
    fi
    exit 1
fi
if [ "$#" -gt 0 ]; then
    note "unknown argument: $1"
    usage
    exit 2
fi

# CLAUDE_CONFIG_DIR is the user-scope Claude config root (it overrides ~/.claude).
# Without it we don't know where settings.json lives, so there is nothing to do.
if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
    note "CLAUDE_CONFIG_DIR is unset; nothing to sync (skipping)."
    exit 0
fi

# jq drives the merge; without it we cannot safely edit JSON, so no-op rather
# than risk corrupting the user's config with text munging.
if ! command -v jq >/dev/null 2>&1; then
    note "jq not found; cannot merge hooks safely (skipping)."
    exit 0
fi

SETTINGS="$CLAUDE_CONFIG_DIR/settings.json"

# Ensure the config dir exists so temp files can be created INSIDE it (below):
# keeping temps on the same filesystem as $SETTINGS makes the final `mv` a true
# atomic rename rather than a cross-device copy+unlink (the bind-mounted config
# dir is on a different filesystem from /tmp, so the default mktemp location
# would defeat the atomicity this relies on).
mkdir -p "$CLAUDE_CONFIG_DIR"

# Report a hook that has stopped producing events BEFORE anything below can exit
# early (#804). A refused write or an unpublishable shim are themselves reasons
# the heartbeat would have stopped, so the report must not be downstream of them.
check_hook_heartbeat "$CLAUDE_CONFIG_DIR/$PROVISION_MARKER_NAME" || true

# --- publish the shim where BOTH sides of the bind mount can reach it (#803) --
# $CLAUDE_CONFIG_DIR is the one directory the container and the host agree on:
# /usr/local/share/claude-home in here, ~/.claude out there, the same bytes
# either way. Copying the shim into it makes the hook command resolvable on the
# host without the host having installed anything — and, because it is the real
# implementation rather than a stub, host sessions record their events instead of
# merely failing quietly. The copy is refreshed on every container create, so it
# tracks the image's version of the shim.
HOOK_DIR="$CLAUDE_CONFIG_DIR/hooks"
HOOK_SHIM="$HOOK_DIR/claude-event-hook"
WORKTREE_SHIM="$HOOK_DIR/worktree-context-hook"
# The three shared security hooks (#811) go to the same place for the same reason:
# $CLAUDE_CONFIG_DIR is the one path both ends of the mount agree on, so a guard
# published here runs for host sessions too. A PreToolUse guard that cannot
# execute reads to the harness as an ALLOW (#805), which is why "the host just
# doesn't get it" is not an acceptable outcome for these two in particular.
GUARD_API_SHIM="$HOOK_DIR/odoo-api-guard.sh"
GUARD_PUSH_SHIM="$HOOK_DIR/force-push-guard.sh"
RECALL_SHIM="$HOOK_DIR/mempalace-recall.sh"

# The command literal written into settings.json. Claude Code runs hook commands
# through `/bin/sh -c`, so this parameter expansion is resolved per machine AT
# HOOK TIME: $CLAUDE_CONFIG_DIR in the container, ~/.claude on a host that does
# not set it — the two ends of the same mount, hence the same file. Single-quoted
# so THIS script never expands it; double quotes are inside the literal so a
# $HOME containing spaces still resolves.
# shellcheck disable=SC2016  # deliberately unexpanded: /bin/sh expands it at hook time
SHIM_CMD='"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/claude-event-hook"'

# Same treatment for the worktree-context hook (#809): publish the real file into
# the shared config dir and reference it through the same per-machine expansion.
# A bare /usr/local/bin path here would reintroduce #803 exactly.
# shellcheck disable=SC2016  # deliberately unexpanded: /bin/sh expands it at hook time
WORKTREE_SHIM_CMD='"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/worktree-context-hook"'

# And the three security hooks (#811), in exactly the same style. Anything else
# here — a container path, or the old /usr/local/share/claude-home one — resolves
# on one side of the mount only.
# shellcheck disable=SC2016  # deliberately unexpanded: /bin/sh expands it at hook time
GUARD_API_CMD='"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/odoo-api-guard.sh"'
# shellcheck disable=SC2016  # deliberately unexpanded: /bin/sh expands it at hook time
GUARD_PUSH_CMD='"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/force-push-guard.sh"'
# shellcheck disable=SC2016  # deliberately unexpanded: /bin/sh expands it at hook time
RECALL_CMD='"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/mempalace-recall.sh"'

# publish_shim <implementation-in-image> <destination-under-$HOOK_DIR>
# Same atomic-rename discipline as the settings write below: stage inside
# $HOOK_DIR (same filesystem), then rename. A hook already executing keeps the
# old inode, so a mid-session republish can never run a half-copied file. An
# unreadable source is not an error here — the callers decide what a missing
# shim means for their own entries.
publish_shim() {
    _src="$1"
    _dst="$2"
    [ -r "$_src" ] || return 0
    _tmp="$(mktemp -p "$HOOK_DIR")"
    if cp "$_src" "$_tmp" 2>/dev/null; then
        chmod 0755 "$_tmp"
        mv "$_tmp" "$_dst"
    else
        rm -f "$_tmp"
        note "could not copy $_src to $_dst."
    fi
}

mkdir -p "$HOOK_DIR"
publish_shim "$HOOK_CMD" "$HOOK_SHIM"
publish_shim "$WORKTREE_HOOK_CMD" "$WORKTREE_SHIM"
publish_shim "$SHARED_HOOKS_DIR/odoo-api-guard.sh" "$GUARD_API_SHIM"
publish_shim "$SHARED_HOOKS_DIR/force-push-guard.sh" "$GUARD_PUSH_SHIM"
publish_shim "$SHARED_HOOKS_DIR/mempalace-recall.sh" "$RECALL_SHIM"

# Refuse to write a command that resolves nowhere — the #803 failure mode. With
# no shim published and none left by an earlier run, writing the entries anyway
# would give every session a 127 per event, so leave settings.json alone.
if [ ! -x "$HOOK_SHIM" ]; then
    note "no event shim at $HOOK_SHIM (and none to publish from $HOOK_CMD); not writing hook entries."
    exit 0
fi

# The worktree-context SessionStart entry (#809) is added only when its shim is
# actually in place. Unlike the event shim this is not worth refusing the whole
# merge over: with no worktree hook the session just goes back to rediscovering
# the constraint by being refused, which is the status quo, whereas a command
# that resolves nowhere costs every session a 127. Its marker stays in
# HOOK_MARKERS either way, so an entry left by an earlier run is still stripped.
if [ -x "$WORKTREE_SHIM" ]; then
    WORKTREE_GROUPS="$(jq -n --arg cmd "$WORKTREE_SHIM_CMD" \
        '[ { "hooks": [ {"type":"command","command":$cmd} ] } ]')"
else
    note "no worktree-context shim at $WORKTREE_SHIM; omitting its SessionStart entry."
    WORKTREE_GROUPS='[]'
fi

# The shared security hooks (#811), each registered only once its own shim is in
# place — same reasoning as the worktree hook. Registering a guard that resolves
# nowhere would be strictly worse than omitting it: Claude Code exit-127s the
# command and a PreToolUse exit-127 reads as an ALLOW (#805), i.e. a prohibition
# that looks enforced and is not. Their markers stay in HOOK_MARKERS either way,
# so an entry a previous run wrote is still stripped when the shim goes away.
#
# Timeouts match what the hand-maintained settings.json used: 20s for the palace
# recall (it loads an embedding stack and caps itself at 18s internally), 5s for
# each guard (a regex over one command string; anything slower is a hang).
if [ -x "$RECALL_SHIM" ]; then
    RECALL_GROUPS="$(jq -n --arg cmd "$RECALL_CMD" \
        '[ { "hooks": [ {"type":"command","command":$cmd,"timeout":20} ] } ]')"
else
    note "no mempalace-recall hook at $RECALL_SHIM; omitting its SessionStart entry."
    RECALL_GROUPS='[]'
fi

GUARD_GROUPS='[]'
if [ -x "$GUARD_API_SHIM" ]; then
    GUARD_GROUPS="$(jq -n --argjson acc "$GUARD_GROUPS" --arg cmd "$GUARD_API_CMD" \
        '$acc + [ { "matcher":"Bash", "hooks": [ {"type":"command","command":$cmd,"timeout":5} ] } ]')"
else
    note "no odoo-api-guard at $GUARD_API_SHIM; omitting its PreToolUse entry."
fi
if [ -x "$GUARD_PUSH_SHIM" ]; then
    GUARD_GROUPS="$(jq -n --argjson acc "$GUARD_GROUPS" --arg cmd "$GUARD_PUSH_CMD" \
        '$acc + [ { "matcher":"Bash", "hooks": [ {"type":"command","command":$cmd,"timeout":5} ] } ]')"
else
    note "no force-push-guard at $GUARD_PUSH_SHIM; omitting its PreToolUse entry."
fi

# The settings fragment (#811, #812). An absent or unparseable fragment degrades to
# {} — the hooks merge below is worth doing on its own, and a half-read policy file
# is not something to write into the user's settings.
FRAGMENT_JSON='{}'
if [ -r "$SETTINGS_FRAGMENT" ]; then
    if jq -e . "$SETTINGS_FRAGMENT" >/dev/null 2>&1; then
        FRAGMENT_JSON="$(cat "$SETTINGS_FRAGMENT")"
    else
        note "$SETTINGS_FRAGMENT is not valid JSON; merging hooks only."
    fi
else
    note "no settings fragment at $SETTINGS_FRAGMENT; merging hooks only."
fi

# The feature-owned hooks block. Each event maps to a dedicated group carrying
# only our command, so the marker-based removal below can strip exactly our
# entries without touching user groups. All seven event names are verified
# against the current Claude Code hooks reference; PreToolUse uses a match-all
# matcher (the shim excludes mcp__odoo-mcp__* itself). Every command here must
# be matched by HOOK_MARKERS — see the contract note beside it.
#
# SessionStart carries THREE feature groups: the event shim first (so the
# `.hooks.SessionStart[0]` the #803 tests pin stays the event shim), then the
# worktree-context hook, then the palace recall (#811). They are separate groups
# because they are separate programs with different contracts — the event shim must
# never write to stdout, and the other two exist precisely to write to it.
#
# PreToolUse likewise carries the match-all event group first, then one Bash-matched
# group per security guard (#811). Separate groups rather than one group with two
# commands, so a guard whose shim is missing drops out on its own.
OURS="$(jq -n --arg cmd "$SHIM_CMD" --argjson wt "$WORKTREE_GROUPS" \
               --argjson recall "$RECALL_GROUPS" --argjson guards "$GUARD_GROUPS" '
  {
    "SessionStart":     ([ { "hooks": [ {"type":"command","command":($cmd+" SessionStart")} ] } ] + $wt + $recall),
    "UserPromptSubmit": [ { "hooks": [ {"type":"command","command":($cmd+" UserPromptSubmit")} ] } ],
    "PreToolUse":       ([ { "matcher":"*", "hooks": [ {"type":"command","command":($cmd+" PreToolUse")} ] } ] + $guards),
    "SubagentStart":    [ { "hooks": [ {"type":"command","command":($cmd+" SubagentStart")} ] } ],
    "SubagentStop":     [ { "hooks": [ {"type":"command","command":($cmd+" SubagentStop")} ] } ],
    "Stop":             [ { "hooks": [ {"type":"command","command":($cmd+" Stop")} ] } ],
    "SessionEnd":       [ { "hooks": [ {"type":"command","command":($cmd+" SessionEnd")} ] } ]
  }
')"

# Resolve the JSON we merge into. An absent file starts from {}. An existing but
# UNPARSEABLE file is left strictly alone — clobbering the user's real settings
# would be far worse than skipping the hook wiring.
if [ -f "$SETTINGS" ]; then
    if ! jq -e . "$SETTINGS" >/dev/null 2>&1; then
        note "$SETTINGS is not valid JSON; leaving it untouched (hooks not merged)."
        exit 0
    fi
    BASE_FILE="$SETTINGS"
else
    BASE_FILE="$(mktemp -p "$CLAUDE_CONFIG_DIR")"
    printf '{}\n' > "$BASE_FILE"
fi

# Merge: for each event we own, drop any pre-existing group whose hooks include
# a marker command (removing a prior run's entries — this is what makes the
# merge idempotent), then append our fresh group. Groups matching no marker —
# i.e. every user-authored hook — are preserved verbatim, as is every other
# top-level setting. `.hooks[$ev]` is coerced to [] only when it is absent or
# not an array, so a user's own array is respected and a malformed scalar can't
# crash the reduce.
#
# The markers also carry the #803 MIGRATION: `claude-event-hook` is a substring
# of the old container-absolute command too, so the stale
# /usr/local/bin/claude-event-hook entries an earlier container wrote into the
# user's settings.json are stripped here and replaced by the shared-path ones.
#
# THE SECOND ARM folds in the settings fragment (#811, #812). Its merge semantics
# are NOT the hooks block's replace-our-own-entries rule, because none of these
# keys is exclusively ours — the user's own values sit in the same places:
#
#   permissions.deny            UNION, user entries first and in their original
#                               order, shipped entries appended, no duplicates.
#                               `$user + ($ship - $user)` does exactly that: jq's
#                               array `-` removes every element present in the
#                               right operand. A host that adds a deny keeps it
#                               across provisions, and the Feature adding one does
#                               not need a hand-edit on every machine.
#   env                         PER KEY, added only when ABSENT. `$ship + $user`
#                               object-merges with the RIGHT side winning, so a
#                               value the user set stays theirs.
#   autoMode.environment        set only when ABSENT. It is one document, not a
#                               set of keys, so there is no sane way to union it —
#                               a present array is left completely alone.
#   skillListingBudgetFraction  set only when ABSENT (#812). A single scalar whose
#                               correct value is a function of how many skills the
#                               Feature installs, not a preference; the unset
#                               default of 0.01 truncates the listing on any 200k
#                               model, and plugin skills are trimmed before bundled
#                               ones, so the odoo-dev skills lose their
#                               descriptions first.
#
# Every one of these is additive or absent-only: this arm can add policy and can
# never remove or overwrite a user's. Opting out therefore means editing
# settings.json, and it sticks for everything except a fragment entry the user
# deleted, which comes back (see NOTES.md).
TMP_OUT="$(mktemp -p "$CLAUDE_CONFIG_DIR")"
if jq \
    --argjson ours "$OURS" \
    --argjson markers "$HOOK_MARKERS" \
    --argjson frag "$FRAGMENT_JSON" '
    .hooks = (.hooks // {})
    | reduce ($ours | keys_unsorted[]) as $ev (.;
        .hooks[$ev] = (
            ( (.hooks[$ev] // []) | if type == "array" then . else [] end )
            | map(select(
                ( [ (.hooks // [])[]? | .command? // "" ] ) as $cmds
                | any($cmds[]; . as $c
                    | any($markers[]; . as $m | $c | contains($m)))
                | not
              ))
        ) + $ours[$ev]
      )
    | ( ( $frag.permissions.deny // [] ) | if type == "array" then . else [] end ) as $shipdeny
    | ( if ($shipdeny | length) > 0 then
          .permissions = ( (.permissions // {}) | if type == "object" then . else {} end )
          | .permissions.deny = (
              ( (.permissions.deny // []) | if type == "array" then . else [] end ) as $userdeny
              | $userdeny + ($shipdeny - $userdeny)
            )
        else . end )
    | ( ( $frag.env // {} ) | if type == "object" then . else {} end ) as $shipenv
    | ( if ($shipenv | length) > 0 then
          .env = ( $shipenv + ( (.env // {}) | if type == "object" then . else {} end ) )
        else . end )
    | ( if ($frag.autoMode.environment != null)
           and (( .autoMode.environment // null ) == null) then
          .autoMode = ( (.autoMode // {}) | if type == "object" then . else {} end )
          | .autoMode.environment = $frag.autoMode.environment
        else . end )
    | ( if ($frag.skillListingBudgetFraction != null)
           and (.skillListingBudgetFraction == null) then
          .skillListingBudgetFraction = $frag.skillListingBudgetFraction
        else . end )
  ' "$BASE_FILE" > "$TMP_OUT" 2>/dev/null && jq -e . "$TMP_OUT" >/dev/null 2>&1; then
    # Only now, with a validated result in hand, replace the real file. TMP_OUT
    # lives in the same directory (hence same filesystem) as $SETTINGS, so this
    # mv is a true atomic rename — a reader never sees a half-written file.
    mv "$TMP_OUT" "$SETTINGS"
    note "merged feature hooks into $SETTINGS."
    # With the file final, resolve every command it now references - ours and the
    # user's (#805). Deliberately AFTER the write: the audit reports on the file
    # sessions will actually run, and a user-owned hook we do not own must never
    # stop the feature's own entries from being wired up.
    if ! audit_hook_commands "$SETTINGS"; then
        if [ "$BASE_FILE" != "$SETTINGS" ]; then
            rm -f "$BASE_FILE"
        fi
        exit 1
    fi
else
    rm -f "$TMP_OUT"
    note "failed to build a valid merged settings.json; leaving $SETTINGS untouched."
    [ "$BASE_FILE" != "$SETTINGS" ] && rm -f "$BASE_FILE"
    exit 0
fi

[ "$BASE_FILE" != "$SETTINGS" ] && rm -f "$BASE_FILE"
exit 0
