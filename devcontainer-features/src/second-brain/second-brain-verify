#!/usr/bin/env bash
set -euo pipefail

# Asserts that the second-brain knowledge base is actually bind-mounted at the
# Feature's fixed container target. Wired as the Feature's onCreateCommand -
# the earliest lifecycle hook that runs inside the created container, where
# runtime mounts are first observable (install.sh runs at image build time and
# can see neither the host environment nor the mounts).
#
# The check is "is the target a real mountpoint", not "does the directory
# exist": if SECOND_BRAIN_DIR was unset/empty on the host, Docker normally
# refuses to create the container at all (empty bind source), but any tooling
# path that instead drops the mount would otherwise leave a plain, empty
# directory here - silently mounting nothing is exactly what this Feature must
# never do.

TARGET="/mnt/second-brain"

fail() {
    echo "ERROR: SECOND_BRAIN_DIR is not set on the host; export it to the knowledge-base directory before building" >&2
    exit 1
}

if command -v mountpoint >/dev/null 2>&1; then
    mountpoint -q -- "$TARGET" || fail
else
    # Minimal images may lack util-linux's mountpoint(1); field 5 of
    # /proc/self/mountinfo is the mount point path.
    awk -v t="$TARGET" '$5 == t { found = 1 } END { exit !found }' /proc/self/mountinfo || fail
fi

echo "second-brain: knowledge base mounted at $TARGET"
