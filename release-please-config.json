{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "packages": {
        ".": {
            "release-type": "simple",
            "component": "personal-features",
            "exclude-paths": [
                ".claude",
                "devcontainer-features/src/second-brain",
                "devcontainer-features/test/second-brain",
                "devcontainer-features/src/debian-eol-archives",
                "devcontainer-features/test/debian-eol-archives",
                "plugins/odoo-dev"
            ],
            "extra-files": [
                {
                    "type": "json",
                    "path": "devcontainer-features/src/personal-features/devcontainer-feature.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "toml",
                    "path": "libraries/odoo_sdk/pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "devcontainer-features/src/second-brain": {
            "release-type": "simple",
            "component": "second-brain",
            "extra-files": [
                {
                    "type": "json",
                    "path": "devcontainer-feature.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "devcontainer-features/src/debian-eol-archives": {
            "release-type": "simple",
            "component": "debian-eol-archives",
            "extra-files": [
                {
                    "type": "json",
                    "path": "devcontainer-feature.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "plugins/odoo-dev": {
            "release-type": "simple",
            "component": "odoo-dev-plugin",
            "extra-files": [
                {
                    "type": "json",
                    "path": ".claude-plugin/plugin.json",
                    "jsonpath": "$.version"
                }
            ]
        }
    }
}
