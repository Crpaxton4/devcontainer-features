{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "plugins": [
        {
            "type": "linked-versions",
            "groupName": "odoo-dev-suite",
            "components": [
                "dispatcher",
                "odoo_client",
                "odoo_dev_data",
                "odoo_dev_core",
                "usage_log",
                "odoo_cli",
                "odoo_mcp",
                "odoo_tui",
                "webui"
            ]
        }
    ],
    "packages": {
        ".": {
            "release-type": "simple",
            "component": "personal-features",
            "exclude-paths": [
                ".claude",
                "devcontainer-features/src/second-brain",
                "devcontainer-features/test/second-brain",
                "devcontainer-features/src/debian-eol-archives",
                "devcontainer-features/test/debian-eol-archives",
                "plugins/odoo-dev",
                "plugins/odoo-orchestrator",
                "libraries/dispatcher",
                "libraries",
                "apps",
                "stack"
            ],
            "extra-files": [
                {
                    "type": "json",
                    "path": "devcontainer-features/src/personal-features/devcontainer-feature.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "devcontainer-features/src/second-brain": {
            "release-type": "simple",
            "component": "second-brain",
            "extra-files": [
                {
                    "type": "json",
                    "path": "devcontainer-feature.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "devcontainer-features/src/debian-eol-archives": {
            "release-type": "simple",
            "component": "debian-eol-archives",
            "extra-files": [
                {
                    "type": "json",
                    "path": "devcontainer-feature.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "libraries/dispatcher": {
            "release-type": "simple",
            "component": "dispatcher",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "libraries/odoo_client": {
            "release-type": "simple",
            "component": "odoo_client",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "libraries/odoo_dev_data": {
            "release-type": "simple",
            "component": "odoo_dev_data",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "libraries/odoo_dev_core": {
            "release-type": "simple",
            "component": "odoo_dev_core",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "libraries/usage_log": {
            "release-type": "simple",
            "component": "usage_log",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "apps/odoo_cli": {
            "release-type": "simple",
            "component": "odoo_cli",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "apps/odoo_mcp": {
            "release-type": "simple",
            "component": "odoo_mcp",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "apps/odoo_tui": {
            "release-type": "simple",
            "component": "odoo_tui",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "apps/webui": {
            "release-type": "simple",
            "component": "webui",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                }
            ]
        },
        "plugins/odoo-dev": {
            "release-type": "simple",
            "component": "odoo-dev-plugin",
            "extra-files": [
                {
                    "type": "json",
                    "path": ".claude-plugin/plugin.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "plugins/odoo-orchestrator": {
            "release-type": "simple",
            "component": "odoo-orchestrator-plugin",
            "extra-files": [
                {
                    "type": "json",
                    "path": ".claude-plugin/plugin.json",
                    "jsonpath": "$.version"
                }
            ]
        }
    }
}
